<?xml version="1.0" encoding="utf-8"?>
<!-- Container added on top of the current screen for the full-screen native countdown ad. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aa_overlay_background"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/aa_full_ad_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/aa_full_countdown"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/aa_bg_countdown"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/aa_full_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/aa_bg_countdown"
        android:contentDescription="@string/aa_close"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="gone" />
</FrameLayout>
